# ---------------------------------------------------------------- frontend ---
# Supabase project settings -> API. The anon key is safe in the browser:
# every table is behind Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------- server / scripts / sim ---
# Service role key. NEVER ship this to the browser. Used by the seed script
# and by edge functions (Supabase injects it there automatically).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Simulator: the device API key printed when you register a device, and the
# functions base URL.
WATERGUARD_API_BASE=https://YOUR-PROJECT.supabase.co/functions/v1
WATERGUARD_DEVICE_KEY=wg_live_...

# --------------------------------------------------------------- notifying ---
# Email is implemented through Resend. SMS/WhatsApp are stubbed: see
# supabase/functions/_shared/notify.ts
RESEND_API_KEY=re_...
ALARM_FROM_EMAIL=waterguard@example.co.za
PUBLIC_APP_URL=https://waterguard.example.co.za
