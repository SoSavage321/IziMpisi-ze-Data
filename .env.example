# ---------------------------------------------------------------- frontend ---
# Firebase is the primary backend. These are client identifiers, not secrets:
# what a signed-in user may read or write is decided by the rules in firebase/.
# Get them with:  firebase apps:sdkconfig WEB --project <your-project>
# Escape hatch: set to false to force the in-browser demo even when the keys
# below are filled in. Useful while the Firebase project is still being set up,
# or for a demo that must not touch real data. Anything other than the exact
# string "false" leaves Firebase switched on.
# VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR-PROJECT
VITE_FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_STORAGE_BUCKET=YOUR-PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# With none of the above set, the dashboard runs entirely in the browser
# against the built-in demo simulation. Nothing else is required.

# ------------------------------------------------- Supabase (alternative) ---
# The Supabase backend is kept in the repo as an alternative to Firebase.
# Leave these blank unless you are using it.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------- server / scripts / sim ---
# Service role key. NEVER ship this to the browser. Used by the seed script
# and by edge functions (Supabase injects it there automatically).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Simulator: the device API key printed when you register a device, and the
# functions base URL.
WATERGUARD_API_BASE=https://YOUR-PROJECT.supabase.co/functions/v1
WATERGUARD_DEVICE_KEY=wg_live_...

# --------------------------------------------------------------- notifying ---
# Email is implemented through Resend. SMS/WhatsApp are stubbed: see
# supabase/functions/_shared/notify.ts
RESEND_API_KEY=re_...
ALARM_FROM_EMAIL=waterguard@example.co.za
PUBLIC_APP_URL=https://waterguard.example.co.za
