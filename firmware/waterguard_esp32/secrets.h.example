/**
 * Copy this file to secrets.h and fill it in. secrets.h is git-ignored.
 *
 * The device key is minted by the dashboard (Settings -> register a device)
 * and shown exactly once. If you lose it, rotate it rather than hunting for it.
 */

#ifndef WATERGUARD_SECRETS_H
#define WATERGUARD_SECRETS_H

#define WIFI_SSID      "your-site-wifi"
#define WIFI_PASSWORD  "your-wifi-password"

// Supabase edge function base, e.g. https://abcdefgh.supabase.co/functions/v1
#define API_BASE       "https://YOUR-PROJECT.supabase.co/functions/v1"

// Per-device API key: wg_live_...
#define DEVICE_KEY     "wg_live_replace_me"

#define FIRMWARE_VERSION "1.0.0"

#endif
